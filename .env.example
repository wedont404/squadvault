# SquadVault: server-side secrets for Supabase Edge Functions
# ---------------------------------------------------------------------------
# These values are NEVER read by the browser. Do not put them in js/config.js.
# Set them on your Supabase project with:
#
#   supabase secrets set --env-file ./.env
#
# (copy this file to .env first; .env is git-ignored)
#
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase. You do not need to set them.

# "simulated" = no provider calls, no real money (development only).
# "live"      = real IntaSend calls. Use this in production.
PAYMENT_MODE=simulated

# --- IntaSend (only needed when PAYMENT_MODE=live) -------------------------
INTASEND_SECRET_KEY=
INTASEND_PUBLISHABLE_KEY=
# true = IntaSend sandbox, false = live
INTASEND_TEST_MODE=true
# The "challenge" string you type into the IntaSend dashboard when you register
# the webhook URL. The webhook function rejects any request that lacks it.
INTASEND_WEBHOOK_CHALLENGE=

# IntaSend REST endpoints. These defaults are UNVERIFIED: the public docs I could
# reach describe the SDK calls (checkout + status by invoice_id) but not the raw
# REST paths. Confirm them in the IntaSend REST API reference before going live.
INTASEND_API_BASE=https://payment.intasend.com
INTASEND_SANDBOX_API_BASE=https://sandbox.intasend.com
INTASEND_CHECKOUT_PATH=/api/v1/checkout/
INTASEND_STATUS_PATH=/api/v1/payment/status/

# Public URL of the app, used for the post-payment redirect.
APP_URL=http://localhost:5173
# Browser origins allowed to call the Edge Functions (comma separated, no trailing slash).
# Add your production domain here when you deploy, e.g. https://squadvault.example.rw
ALLOWED_ORIGINS=http://localhost:5173
